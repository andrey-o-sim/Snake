<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Snake.Wpf.Views.PlayerNameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="32" MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource TitleText}" Text="{Binding Title}" />

        <TextBlock Margin="0,0,0,8" Text="Как вас зовут?" />

        <TextBox x:Name="NameBox"
                 AutomationProperties.Name="Имя игрока"
                 MaxLength="{Binding MaxLength}"
                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Margin="0,8,0,16" Style="{StaticResource HintText}" Text="{Binding Hint}" />

        <Button Command="{Binding ConfirmCommand}" Content="Сохранить" />

        <Button Command="{Binding CancelCommand}"
                Content="Отмена"
                Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock Margin="0,16,0,0"
                   Style="{StaticResource HintText}"
                   Text="Enter — сохранить, Esc — отмена." />
    </StackPanel>
</UserControl>
