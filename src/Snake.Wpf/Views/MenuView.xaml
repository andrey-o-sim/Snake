<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Snake.Wpf.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource TitleText}" Text="Змейка" />

        <TextBlock Grid.Row="1" Margin="0,0,0,16" Text="{Binding Greeting}" />

        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Margin="0,0,0,6" Style="{StaticResource HintText}" Text="Уровень сложности" />
            <ListBox ItemsSource="{Binding Difficulties}"
                     SelectedItem="{Binding SelectedDifficulty}"
                     AutomationProperties.Name="Уровень сложности">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock FontSize="18" Text="{Binding Title}" />
                            <TextBlock Style="{StaticResource HintText}" Text="{Binding Rule}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <StackPanel Grid.Row="3">
            <Button x:Name="StartButton" Command="{Binding StartCommand}" Content="Начать игру" />
            <Button Command="{Binding HighScoresCommand}" Content="Рекорды" />
            <Button Command="{Binding ChangeNameCommand}" Content="Изменить имя игрока" />
            <Button Command="{Binding ExitCommand}" Content="Выход" />
        </StackPanel>

        <TextBlock Grid.Row="4"
                   Margin="0,16,0,0"
                   Style="{StaticResource HintText}"
                   Text="Tab и стрелки — переход между элементами, Enter — выбор." />
    </Grid>
</UserControl>
