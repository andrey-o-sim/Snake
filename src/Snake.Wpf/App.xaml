<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="Snake.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Snake.Wpf.ViewModels"
             xmlns:views="clr-namespace:Snake.Wpf.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type viewModels:MenuViewModel}">
                <views:MenuView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:PlayerNameViewModel}">
                <views:PlayerNameView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:GameViewModel}">
                <views:GameView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:HighScoresViewModel}">
                <views:HighScoresView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
